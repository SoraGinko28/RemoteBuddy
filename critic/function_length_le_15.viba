# 二阶 critic 的第一条规则：每个函数的代码不得超过 15 行。
#
# 规则是一个程序：environ 进、bool 出。它不认任何一场会议、任何一个时刻——
# 案子是低阶 critic 交进来的材料（一条 mc.ScreenReference：哪一刻、哪个流、屏幕上哪一段），
# 读它的地址由批判者选。所以同一条规则可以判任何一刻。
#
# 读会议是唯一不纯的一步，走 measure：答案存成这个案子的 Prepare，此后每次判定直接回放。
# 每条调用只给一个环境，而且给的是案子的环境——证据就落在案子的地址下面。

import meeting_core as mc

# 这次判定的案子：低阶 critic 呈上来的屏幕引用放在这条子环境下面，规则从那儿读
subject_env = environ.sub_env << "screen_reference_under_judgment"

cited_screen_reference =
    mc.ScreenReference
    <- $env Environment
    <- {
        低阶 critic 呈上来的那条屏幕引用：哪一刻、哪个流、屏幕上哪一段
    }

max_function_lines =
    int
    <- $env Environment
    <- $subject mc.ScreenReference
    <- {
        这份材料里最长的那个函数有多少行代码
    }

worst_function_name =
    str
    <- $env Environment
    <- $subject mc.ScreenReference
    <- {
        最长的是哪一个函数：问句里要指名道姓
    }

within_limit =
    bool
    <- $env Environment
    <- $lines int
    <- $name str
    <- $limit int
    <- {
        这个函数有没有超过上限
    }

# 这次判定的主体：批判者呈上来的那条引用
the_subject = cited_screen_reference << $env subject_env

# 测量：读会议、找出最长的函数
max_lines = max_function_lines << $env subject_env << $subject the_subject

worst = worst_function_name << $env subject_env << $subject the_subject

# 规则的判断：门槛是规则自己给的，换个门槛写的还是同一个函数
limit = 15

__ret__ = within_limit
    << $env subject_env
    << $lines max_lines
    << $name worst
    << $limit limit
