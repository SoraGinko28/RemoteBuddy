# 助理的第二条规则：actor 回话了，但没人复查过。
#
# 和第一条是一对：第一条管"该回的人不说话"，这一条管"回了话但没人看"。
# 两条判的是同一个案子（critic 最后说的那句话）；区别只在测量：
# 那句话之后 actor 有没有回音——没有，看沉默了多久；有，数一数有几句话还没被复查。
#
# 为什么要有这一条：actor 说"改好了"不等于问题解决了。规则在 critic 手里，
# 只有 critic 再看一眼、规则不再报违规，才算解决。所以这条规则一旦违规，
# 助理要做的不是自己判，而是请 critic 复查。

import meeting_core as mc

# 这次判定的案子：助理呈上来的那条聊天引用放在这条子环境下面，规则从那儿读
subject_env = environ.sub_env << "unanswered_message_under_judgment"

cited_critic_message =
    mc.ChatReference
    <- $env Environment
    <- {
        助理呈上来的那条聊天引用：critic 最后说的那句话
    }

unreviewed_replies =
    int
    <- $env Environment
    <- $subject mc.ChatReference
    <- {
        这句话之后 actor 回了几句，还没被复查
    }

unanswered_member =
    str
    <- $env Environment
    <- $subject mc.ChatReference
    <- {
        这些回应是谁说的
    }

within_review_limit =
    bool
    <- $env Environment
    <- $replies int
    <- $who str
    <- $limit int
    <- {
        这些回应是不是都已经复查过了
    }

# 这次判定的主体：助理呈上来的那条引用
the_subject = cited_critic_message << $env subject_env

# 测量：读会议、数一数没人复查的回应
unreviewed = unreviewed_replies << $env subject_env << $subject the_subject

who = unanswered_member << $env subject_env << $subject the_subject

# 规则的判断：一句没复查都不允许
limit = 0

__ret__ = within_review_limit
    << $env subject_env
    << $replies unreviewed
    << $who who
    << $limit limit
