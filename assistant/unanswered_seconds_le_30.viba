# 助理的第一条规则：该回应的那个人不能一直沉默。
#
# 和 critic 的规则一样，规则是一个程序：environ 进、bool 出。它不认任何一场会议、任何一句话——
# 案子是低阶助理交进来的材料（一条 mc.ChatReference：谁在什么时候说了哪句话），
# 读它的地址由助理选。所以同一条规则可以判任何一句话。
#
# 它管的是"没人接话"：critic 提了问题或警告之后，该回应的人（actor）一直不吭声，
# 超过宽限就是违规——违规不是"谁说错了"，而是"这轮对话卡住了"。
# 所以助理拿到违规时说的话不是给 critic 的，是给 actor 的：请它回应。
#
# 读会议是唯一不纯的一步，走 measure：答案存成这个案子的 Prepare，此后每次判定直接回放。
# 每条调用只给一个环境，而且给的是案子的环境——证据就落在案子的地址下面。

import meeting_core as mc

# 这次判定的案子：助理呈上来的那条聊天引用放在这条子环境下面，规则从那儿读
subject_env = environ.sub_env << "unanswered_message_under_judgment"

cited_critic_message =
    mc.ChatReference
    <- $env Environment
    <- {
        助理呈上来的那条聊天引用：谁在什么时候说的哪句话
    }

max_unanswered_seconds =
    int
    <- $env Environment
    <- $subject mc.ChatReference
    <- {
        从这句话到现在，该回应的人沉默了多少秒
    }

unanswered_member =
    str
    <- $env Environment
    <- $subject mc.ChatReference
    <- {
        该回应却一直不吭声的是谁
    }

within_answer_grace =
    bool
    <- $env Environment
    <- $seconds int
    <- $who str
    <- $limit int
    <- {
        这份沉默有没有还在宽限之内
    }

# 这次判定的主体：助理呈上来的那条引用
the_subject = cited_critic_message << $env subject_env

# 测量：读会议、看这句话之后有没有人接话
waited = max_unanswered_seconds << $env subject_env << $subject the_subject

who = unanswered_member << $env subject_env << $subject the_subject

# 规则的判断：宽限是规则自己给的，换个宽限写的还是同一条对话
limit = 30

__ret__ = within_answer_grace
    << $env subject_env
    << $seconds waited
    << $who who
    << $limit limit
