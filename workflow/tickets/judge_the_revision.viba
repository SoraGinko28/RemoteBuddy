__decl__ =
    ($module_path str * $func_name str)
  <- $env Env

args = __get_args__ << __decl__

# design/tickets/judge_the_revision.viba
#
# assistant 看情况发起这一张——改的那一版交上来了、还没判过的时候。

import critic_api as critic

__impl__ = critic.judge
  << $env ($sub_env << args.env << "judged_revision")
  << $code ($module_path "revised" * $func_name "revise_code")
