__decl__ =
    ($module_path str * $func_name str)
  <- $env Env

args = __get_args__ << __decl__

# design/tickets/judge_the_draft.viba
#
# assistant 看情况发起这一张——第一版交上来了（drafted + write_code 有答案）、还没判过的时候。
# 判下来的结论落在 judged 这条数据路径下：judge 是那个 bool，objection 是说不合格的那句话。

import critic_api as critic

__impl__ = critic.judge
  << $env ($sub_env << args.env << "judged")
  << $code ($module_path "drafted" * $func_name "write_code")
