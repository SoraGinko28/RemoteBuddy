__decl__ =
    ($module_path str * $func_name str)
  <- $env Env

args = __get_args__ << __decl__

# design/tickets/revise_the_draft.viba
#
# assistant 看情况发起这一张——判过了、改的那一版还没交上来的时候。

import actor_api as actor

revised = actor.revise_code
  << $env ($sub_env << args.env << "revised")
  << $code ($module_path "drafted" * $func_name "write_code")
  << $objection ($module_path "judged" * $func_name "objection")

__impl__ = actor.report_done
  << $env ($sub_env << args.env << "revised_done")
  << $code revised
  << $after revised
