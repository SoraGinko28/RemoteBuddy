# actor 对外的接口：它在会议里会做的事。实现是 actor 自己的（一个会写代码的 agent）。
#
# 结果和实参都是同一个写法：`$module_path`（这次调用跑在哪条数据路径下）和 `$func_name`（到了哪个
# 定义）——`interpret` 递延里给的就是这两样。材料不在这里面：材料在 store 里，谁要用谁照这两样去读。
# 哪个案子、写什么代码，这份文件里一个字都不出现：案子由跑的时候给的 $env 决定。

acknowledge =
    ($module_path str * $func_name str)
  <- $env environ
  <- $about ($module_path str * $func_name str)
  <- { 在会议里回一句"知道了"：回的是 $about 那件事；话由说话的人自己说 }

write_code =
    ($module_path str * $func_name str)
  <- $env environ
  <- $task ($module_path str * $func_name str)
  <- $after ($module_path str * $func_name str)
  <- { 接在 $after 那一步之后，照 $task 那份题面写一版代码，放在这条数据路径下 }

report_done =
    ($module_path str * $func_name str)
  <- $env environ
  <- $code ($module_path str * $func_name str)
  <- $after ($module_path str * $func_name str)
  <- { 接在 $after 之后回一句"做好了"，成果在 $code；话由说话的人自己说 }

revise_code =
    ($module_path str * $func_name str)
  <- $env environ
  <- $code ($module_path str * $func_name str)
  <- $objection ($module_path str * $func_name str)
  <- { 照判语改一版：$code 是上一版，$objection 说的是哪里不合格 }
